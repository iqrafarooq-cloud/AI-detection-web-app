# Copy to .env.local and fill in. Never commit real keys.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# --- Supabase (auth, history, preferences, contact form) --------------------
# Project Settings -> API. Use the publishable key (or the legacy anon key).
# NEVER put the service_role / secret key here - the app does not need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy alternative to the publishable key

# --- Writing improvement (Humanizer) -----------------------------------------
# anthropic | groq | auto (auto = Anthropic if its key is set, otherwise Groq)
REWRITE_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Groq (free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# REWRITE_TIMEOUT_MS=180000
# Long texts are rewritten in sections of this many characters (default: Groq 5000, Anthropic 40000).
# REWRITE_CHUNK_CHARS=5000

# --- AI detection (independent provider) -------------------------------------
# local | sapling | gptzero | none
#   local   = open-source TMR RoBERTa detector + GPT-2 perplexity, run on this server
#             with ONNX Runtime (no API key; models download on first use, ~650 MB)
#   sapling / gptzero = commercial APIs (need the key below)
#   none    = no AI-likelihood estimate, only the writing-pattern analysis
DETECTION_PROVIDER=local
# HF_CACHE_DIR=.cache/huggingface        # use /tmp/hf on read-only hosts
# HF_DETECTOR_MODEL=onnx-community/tmr-ai-text-detector-ONNX
# HF_DETECTOR_DTYPE=q8
# HF_PERPLEXITY_MODEL=Xenova/gpt2
# HF_PERPLEXITY_DTYPE=fp32
SAPLING_API_KEY=
GPTZERO_API_KEY=
# DETECTION_TIMEOUT_MS=30000

# --- Limits (optional) ---------------------------------------------------------
# ANALYZE_MAX_CHARS=50000
# HUMANIZE_MAX_CHARS=20000
# GRAMMAR_MAX_CHARS=12000     # keep one request within your provider's tokens-per-minute limit
# SUMMARIZE_MAX_CHARS=15000
# UPLOAD_MAX_BYTES=4194304   # keep under 4.5 MB on Vercel
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_ANALYZE=20
# RATE_LIMIT_HUMANIZE=10
# RATE_LIMIT_GRAMMAR=10
# RATE_LIMIT_SUMMARIZE=10
# RATE_LIMIT_UPLOAD=20
# RATE_LIMIT_CONTACT=3
